# CuraTrack Mobile — Environment Variables
# Copy this to .env and fill in your values

# Supabase (same as web frontend)
EXPO_PUBLIC_SUPABASE_URL=https://jouwxykvjjtdgmsfzkgw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastAPI Backend URL
# Render Deployment: https://curatrack-backend.onrender.com
# Local Network Dev: http://192.168.1.10:8000
EXPO_PUBLIC_API_BASE_URL=https://curatrack-backend.onrender.com

# Web Frontend URL (Deployed on Vercel)
EXPO_PUBLIC_WEB_BASE_URL=https://curatrack-v2.vercel.app

# Google OAuth Client ID (Android/iOS)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
