#!/bin/sh
# ==============================================================================
# CuraTrack Local Pre-Push Enforcer
# Runs full automated test suite (Backend, Website, Mobile) before git push.
# If any test fails, Git immediately rejects and aborts the push before transmission.
# ==============================================================================

echo ""
echo "==========================================================================="
echo "  [CURATRACK LOCAL PRE-PUSH HOOK]: Executing Full Automated Test Suite"
echo "==========================================================================="
echo ""

# Robust Python discovery across Windows (Git Bash/CMD/PS), macOS, and Linux
PYTHON_CMD=""

if command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
    PYTHON_CMD="py -3"
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
    PYTHON_CMD="python3"
elif [ -f "/c/Users/aksha/AppData/Local/Programs/Python/Python314/python.exe" ]; then
    PYTHON_CMD="/c/Users/aksha/AppData/Local/Programs/Python/Python314/python.exe"
elif [ -f "C:/Users/aksha/AppData/Local/Programs/Python/Python314/python.exe" ]; then
    PYTHON_CMD="C:/Users/aksha/AppData/Local/Programs/Python/Python314/python.exe"
elif [ -f "/c/Users/Sakth/AppData/Local/Programs/Python/Python313/python.exe" ]; then
    PYTHON_CMD="/c/Users/Sakth/AppData/Local/Programs/Python/Python313/python.exe"
elif [ -f "C:/Users/Sakth/AppData/Local/Programs/Python/Python313/python.exe" ]; then
    PYTHON_CMD="C:/Users/Sakth/AppData/Local/Programs/Python/Python313/python.exe"
else
    echo "ERROR: Valid Python interpreter not found."
    echo "Please ensure Python 3.10+ is installed and accessible in PATH."
    exit 1
fi

$PYTHON_CMD tests/run_all_tests.py
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "==========================================================================="
    echo "  [PUSH REJECTED]: Automated test verification failed!"
    echo "  Your push was aborted locally BEFORE transmission to GitHub."
    echo "  Please fix the failing tests reported above and try pushing again."
    echo "==========================================================================="
    echo ""
    exit 1
fi

echo ""
echo "==========================================================================="
echo "  [PUSH APPROVED]: All automated test suites passed. Transmitting push."
echo "==========================================================================="
echo ""
exit 0
