{
  "expo": {
    "name": "CuraTrack",
    "slug": "curaTrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "curatrackmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.curatrack.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "CuraTrack needs camera access to scan medical documents.",
        "NSPhotoLibraryUsageDescription": "CuraTrack needs photo library access to upload medical documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.curatrack.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CuraTrack needs access to your photos to upload medical documents.",
          "cameraPermission": "CuraTrack needs access to your camera to scan medical documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D8AED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
